@page "/"
@using System.Diagnostics;
@using Knapcode.FactorioTools.OilField;

<PageTitle>Factorio oil field planner</PageTitle>

<h1>Factorio oil field planner</h1>
<p>This planner runs entirely in your browser. No blueprint data is sent to a server.</p>

<div class="mb-3">
    <label class="form-label" for="input-blueprint">Input blueprint</label>
    <textarea class="form-control font-monospace" id="input-blueprint" rows="6" @bind="InputBlueprint" @bind:event="oninput" spellcheck="false"></textarea>
</div>

<div class="form-check mb-2">
    <input class="form-check-input" id="add-beacons" type="checkbox" @bind="AddBeacons" />
    <label class="form-check-label" for="add-beacons">Add beacons</label>
</div>

<div class="form-check mb-2">
    <input class="form-check-input" id="add-electric-poles" type="checkbox" @bind="AddElectricPoles" />
    <label class="form-check-label" for="add-electric-poles">Add electric poles</label>
</div>

@if (AddElectricPoles)
{
    <div class="mb-3">
        <label class="form-label" for="electric-pole-type">Electric pole type</label>
        <select class="form-select" id="electric-pole-type" @bind="ElectricPoleType">
            <option value="small">Small electric pole</option>
            <option value="medium">Medium electric pole</option>
            <option value="big">Big electric pole</option>
            <option value="substation">Substation</option>
        </select>
        <div class="form-text">Each plan uses one selected pole type.</div>
    </div>
}

<div class="form-check mb-3">
    <input class="form-check-input" id="add-heat-pipes" type="checkbox" @bind="AddHeatPipes" />
    <label class="form-check-label" for="add-heat-pipes">Add heat pipes for Aquilo</label>
    <div class="form-text">Adds one connected heat-pipe network beside pumpjacks, fluid pipes, and beacons. Connect it to a heating tower or reactor after placement.</div>
</div>

<button class="btn btn-primary mb-3" @onclick="Plan" disabled="@Loading">@(Loading ? "Planning..." : "Plan oil field")</button>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger">@Error</div>
}

@if (!string.IsNullOrEmpty(OutputBlueprint))
{
    <div class="mb-3">
        <label class="form-label" for="output-blueprint">Output blueprint</label>
        <textarea class="form-control font-monospace" id="output-blueprint" rows="6" readonly>@OutputBlueprint</textarea>
        <div class="form-text">@Status</div>
    </div>
}

@code {
    public string Error { get; set; } = string.Empty;
    public string InputBlueprint { get; set; } = "0eJyMj70OwjAMhN/lZg8NbHkVhFB/rMrQuFGSIqoq707aMiCVgcWSz+fP5wXNMLEPogl2gbSjRtjLgii91sOqae0YFn5y/l63DxDS7FdFEjtkgmjHL1iTrwTWJEl4Z2zNfNPJNRyKgX6w/BjLwqjrpQI5E+ZSC7WTwO0+qTIdYKc/YKbaaOaAK0G38Pbre8KTQ/wY8hsAAP//AwAEfF3F";
    public string OutputBlueprint { get; set; } = string.Empty;
    public string Status { get; set; } = string.Empty;
    public bool Loading { get; set; }
    public bool AddBeacons { get; set; } = true;
    public bool AddElectricPoles { get; set; } = true;
    public bool AddHeatPipes { get; set; }
    public string ElectricPoleType { get; set; } = "medium";

    private void Plan()
    {
        if (string.IsNullOrEmpty(InputBlueprint))
        {
            return;
        }

        OutputBlueprint = string.Empty;
        Error = string.Empty;
        Loading = true;
        Status = "Running...";
        var sw = Stopwatch.StartNew();

        try
        {
            var options = ElectricPoleType switch
            {
                "small" => OilFieldOptions.ForSmallElectricPole,
                "big" => OilFieldOptions.ForBigElectricPole,
                "substation" => OilFieldOptions.ForSubstation,
                _ => OilFieldOptions.ForMediumElectricPole,
            };
            options.AddBeacons = AddBeacons;
            options.AddElectricPoles = AddElectricPoles;
            options.AddHeatPipes = AddHeatPipes;
            var bp = ParseBlueprint.Execute(InputBlueprint);
            (var context, _) = Planner.Execute(options, bp);
            OutputBlueprint = GridToBlueprintString.Execute(context, addFbeOffset: false, addAvoidEntities: false);
            Status = "Done: " + sw.Elapsed;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            Status = "Error.";
        }
        finally
        {
            Loading = false;
        }
    }
}
